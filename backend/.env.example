# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/academic_knowledge_hub

# JWT Secret for Session Authentication
JWT_SECRET=academic_knowledge_hub_jwt_super_secure_random_key_replace_in_prod
JWT_EXPIRES_IN=7d

# Google Gemini API Key (Required for PDF Embeddings and RAG Q&A Assistant)
GEMINI_API_KEY=

# Cloudinary Storage (Required for cloud PDF hosting; falls back to local disk if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth 2.0 (Optional; standard email/password authentication is always enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
